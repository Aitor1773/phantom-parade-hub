---
// Página "próximamente" para cada sección del menú que aún no existe.
// Cuando una sección se construya, su página propia tendrá prioridad.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { ALL_LINKS, type NavLink } from '@/config/nav';
import { LOCALES, localePath, useT, type Locale } from '@/i18n/utils';

export function getStaticPaths() {
  // Secciones que ya tienen página propia (no generan "próximamente")
  const BUILT = new Set(['/characters', '/memories', '/banners', '/codes', '/account', '/tier-list', '/tools/pulls', '/tools/tier-maker', '/tools/collection', '/tools/compare', '/banners/history','/guides/beginner', '/guides/mechanics', '/best-teams', '/teams', '/team-builder']);
  return LOCALES.flatMap((lang) =>
    ALL_LINKS.filter((link) => !BUILT.has(link.path)).map((link) => ({
      params: { lang, section: link.path.slice(1) },
      props: { link },
    })),
  );
}

const lang = Astro.params.lang as Locale;
const { link } = Astro.props as { link: NavLink };
const t = useT(lang);
---

<BaseLayout lang={lang} title={t(link.label)} description={t(link.desc)}>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-28 text-center">
    <span class="relative grid size-20 place-items-center rounded-2xl border border-line-strong bg-coal text-ember">
      <span class="absolute inset-0 animate-pulse rounded-2xl bg-ember/10"></span>
      <Icon name={link.icon} size={36} />
    </span>
    <p class="eyebrow mt-8">{t('soon.title')}</p>
    <h1 class="mt-3 text-4xl font-black text-bone sm:text-5xl">{t(link.label)}</h1>
    <p class="mt-4 max-w-lg text-dust">{t(link.desc)}</p>
    <p class="mt-2 text-sm text-smoke">{t('soon.desc', { phase: link.phase })}</p>
    <a href={localePath(lang)} class="btn-secondary mt-10">
      <Icon name="home" size={16} />
      {t('soon.back')}
    </a>
  </section>
</BaseLayout>
