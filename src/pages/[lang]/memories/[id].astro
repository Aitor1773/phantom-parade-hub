---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import MemoryEffects from '@/components/memories/MemoryEffects';
import { MEMORIES, illustSrc, type Memory } from '@/data/memories';
import { CHARACTERS, thumb } from '@/data/characters';
import { gameDict, useG, type GameKey } from '@/i18n/game';
import { LOCALES, LOCALE_META, localePath, useT, type Locale } from '@/i18n/utils';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => MEMORIES.map((m) => ({ params: { lang, id: m.id }, props: { m } })));
}

const lang = Astro.params.lang as Locale;
const { m } = Astro.props as { m: Memory };
const t = useT(lang);
const g = useG(lang);

const date = (iso: string | null) =>
  iso ? new Intl.DateTimeFormat(LOCALE_META[lang].htmlLang, { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(iso + 'T00:00:00Z')) : '—';
const pct = new Intl.NumberFormat(LOCALE_META[lang].htmlLang, { maximumFractionDigits: 2 });

// Personajes cuya ficha recomienda esta memoria
const usedBy = CHARACTERS.filter((c) => c.memories.some((x) => x.id === m.id));

const STATS = [
  { label: g('ch.hp'), value: m.stats.hp },
  { label: g('or.taijutsu'), value: m.stats.taijutsu },
  { label: g('or.jujutsu'), value: m.stats.jujutsu },
];
const statMax = Math.max(...MEMORIES.flatMap((x) => [x.stats.hp ?? 0, x.stats.taijutsu ?? 0, x.stats.jujutsu ?? 0]));
const rarityClass = { SSR: 'badge-ssr', SR: 'badge-sr', R: 'badge-r' }[m.rarity] ?? 'badge';
const hero = illustSrc(m, 1440);

const labels = gameDict(lang, ['mem.lv1', 'mem.lv2', 'mem.effect1', 'mem.effect2', 'mem.cd'] as const);
const description = `${m.name} — ${m.rarity} ${g('mem.title')}. ${m.effects[0]?.text.split('\n').slice(0, 2).join(' ') ?? ''}`;
---

<BaseLayout lang={lang} title={m.name} description={description}>
  <!-- Cabecera -->
  <section class="relative isolate overflow-hidden border-b border-line">
    {hero && <img src={illustSrc(m, 640)} alt="" aria-hidden="true" class="absolute inset-0 -z-20 h-full w-full scale-110 object-cover opacity-20 blur-2xl" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ash/40 via-ash/70 to-ash"></div>
    <div class="mx-auto max-w-6xl px-4 py-10 lg:px-6 lg:py-14">
      <a href={localePath(lang, '/memories')} class="inline-flex items-center gap-1.5 text-sm text-dust transition hover:text-bone">
        <Icon name="arrowRight" size={14} class="rotate-180" />
        {g('mem.back')}
      </a>

      <div class="mt-6 overflow-hidden rounded-2xl border border-line-strong bg-coal shadow-2xl shadow-black/60">
        {hero ? (
          <img src={hero} srcset={m.illustWidths.map((w) => `${m.illust}-${w}.webp ${w}w`).join(', ')} sizes="(min-width: 1152px) 1104px, 100vw" alt={m.name} class="aspect-[2/1] w-full object-cover" />
        ) : (
          <div class="slash grid aspect-[2/1] place-items-center bg-gradient-to-br from-blood/50 to-coal text-sm text-smoke">{g('mem.noimage')}</div>
        )}
      </div>

      <h1 class="mt-8 text-4xl leading-tight font-black text-bone sm:text-5xl">{m.name}</h1>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class={rarityClass}>{m.rarity}</span>
        <span class="badge border-line-strong bg-cinder text-dust">{g(`or.${m.orientation}` as GameKey)}</span>
        <span class={m.availability === 'f2p' ? 'badge-verified' : m.availability === 'gacha' ? 'badge-jp' : 'badge-limited'}>{g(`av.${m.availability}` as GameKey)}</span>
        {m.adjusted && <span class="badge-unverified">{g('mem.adjusted')}</span>}
        {m.tags.map((tag) => <span class="badge border-ember/30 bg-ember/5 text-ember">{g(`tag.${tag}` as GameKey)}</span>)}
      </div>
      <p class="mt-4 text-sm text-smoke">{g('ch.released')}: <span class="text-dust">{date(m.releaseDateJP)}</span></p>
    </div>
  </section>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:px-6">
    <section>
      <h2 class="mb-5 text-2xl font-bold text-bone">{g('mem.effects')}</h2>
      {m.effects.length ? (
        <MemoryEffects client:visible effects={m.effects} labels={labels} textLangNote={lang === 'en' ? null : g('ch.textlang')} />
      ) : (
        <p class="card p-6 text-sm text-smoke">—</p>
      )}

      {usedBy.length > 0 && (
        <>
          <h2 class="mt-12 mb-5 text-2xl font-bold text-bone">{g('mem.usedby')}</h2>
          <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6">
            {usedBy.map((c) => (
              <li>
                <a href={localePath(lang, `/characters/${c.id}`)} class="group block overflow-hidden rounded-xl border border-line bg-coal transition hover:border-line-strong">
                  {c.art ? (
                    <img src={thumb(c.art, 320)} alt="" loading="lazy" class="aspect-[3/4] w-full object-cover object-top transition duration-500 group-hover:scale-105" />
                  ) : (
                    <div class="aspect-[3/4] bg-cinder"></div>
                  )}
                  <p class="truncate px-2 py-1.5 text-[11px] font-medium text-bone">{c.name}</p>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </section>

    <aside class="space-y-6 lg:sticky lg:top-[calc(var(--nav-h)+24px)] lg:self-start">
      <section class="card p-5">
        <h2 class="font-sans text-sm font-bold text-bone">{g('mem.stats')}</h2>
        {m.stats.level && <p class="text-xs text-smoke">{g('mem.stats.level', { n: m.stats.level })}</p>}
        <ul class="mt-4 space-y-3.5">
          {STATS.map((s) => (
            <li>
              <div class="flex items-baseline justify-between text-sm">
                <span class="text-dust">{s.label}</span>
                <span class="font-semibold text-bone tabular-nums">{s.value != null ? `+${pct.format(s.value)}%` : '—'}</span>
              </div>
              <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-cinder">
                <div class="h-full rounded-full bg-gradient-to-r from-ember to-flame" style={`width:${Math.round(((s.value ?? 0) / statMax) * 100)}%`}></div>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="card p-5">
        <h2 class="font-sans text-sm font-bold text-bone">{g('ch.source')}</h2>
        <p class="mt-3"><span class="badge-unverified">{g('ch.source.single')}</span></p>
        <dl class="mt-4 space-y-2 text-xs">
          <div class="flex justify-between gap-3">
            <dt class="text-smoke">{g('ch.source.updated')}</dt>
            <dd class="text-dust">{date(m._source.updated.slice(0, 10))}</dd>
          </div>
        </dl>
        <a href={m._source.url} target="_blank" rel="noopener" class="btn-secondary mt-4 w-full text-xs">
          {g('ch.source.view')}
          <Icon name="arrowRight" size={14} class="-rotate-45" />
        </a>
        <p class="mt-3 text-[11px] leading-relaxed text-smoke">{t('footer.license')}</p>
      </section>
    </aside>
  </div>
</BaseLayout>
