---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import TierMaker from '@/components/tools/TierMaker';
import { CHARACTERS, thumb } from '@/data/characters';
import { tierOf } from '@/data/gacha';
import { SITE } from '@/config/site';
import { gameDict, type GameKey } from '@/i18n/game';
import { localePath, staticLocalePaths, useT, type Locale } from '@/i18n/utils';

export const getStaticPaths = staticLocalePaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);
const KEYS = [
  'tk.pool', 'tk.hint', 'tk.reset', 'tk.fill', 'tk.share', 'tk.copied', 'tk.download', 'tk.name', 'tk.default', 'tk.search', 'tk.all',
] as const satisfies readonly GameKey[];
const labels = gameDict(lang, KEYS);
const colors = gameDict(lang, ['el.red', 'el.blue', 'el.green', 'el.yellow'] as const);
// Personajes con su miniatura y el rango de nuestra tier list por color (para «Empezar con nuestra tier list»)
const chars = CHARACTERS.map((c) => ({ id: c.id, name: c.name, ep: c.epithet ?? null, el: c.element, img: thumb(c.art, 320) }));
const preset = Object.fromEntries(CHARACTERS.map((c) => [c.id, tierOf(c.id, c.element).rank]).filter(([, r]) => r));
---

<BaseLayout lang={lang} title={t('nav.tiermaker')} description={t('nav.tiermaker.desc')}>
  <div class="mx-auto max-w-7xl px-4 pt-12 pb-8 lg:px-6">
    <header class="mb-8">
      <p class="eyebrow flex items-center gap-1.5"><Icon name="trophy" size={13} /> {t('nav.tools')}</p>
      <h1 class="mt-2 text-4xl font-black text-bone sm:text-5xl">{t('nav.tiermaker')}</h1>
      <p class="mt-3 max-w-2xl text-dust">{t('nav.tiermaker.desc')}. <a href={localePath(lang, '/tier-list')} class="text-flame underline underline-offset-2">{t('nav.tierlist')}</a></p>
    </header>
    <TierMaker client:only="react" chars={chars} preset={preset} labels={labels}
      colors={{ red: colors['el.red'], blue: colors['el.blue'], green: colors['el.green'], yellow: colors['el.yellow'] }} siteName={SITE.name} />
  </div>
</BaseLayout>
