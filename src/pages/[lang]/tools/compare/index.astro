---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Compare, { type CmpChar } from '@/components/tools/Compare';
import { CHARACTERS, kitVersions, resolveKit, thumb } from '@/data/characters';
import { tierOf } from '@/data/gacha';
import { gameDict, useG, type GameKey } from '@/i18n/game';
import { LOCALE_META, localePath, staticLocalePaths, useT, type Locale } from '@/i18n/utils';

export const getStaticPaths = staticLocalePaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);
const g = useG(lang);
const labels = gameDict(lang, [
  'cmp.pick', 'cmp.empty', 'cmp.profile', 'cmp.rarity', 'cmp.element', 'cmp.role', 'cmp.avail', 'cmp.tier', 'cmp.yes', 'cmp.no',
  'cmp.best', 'cmp.remove', 'cmp.open', 'ch.bf', 'ch.released', 'ch.stats', 'ch.hp', 'ch.attack', 'ch.jujutsu', 'ch.gauge', 'ch.ce',
  'ch.skills', 'ch.cost', 'ch.memories',
] as const);
const date = (d: string | null) =>
  d ? new Intl.DateTimeFormat(LOCALE_META[lang].htmlLang, { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(d + 'T00:00:00Z')) : '—';
const SLOTS = [['normal', 'ch.normal'], ['s1', 'ch.s1'], ['s2', 'ch.s2'], ['ult', 'ch.ult']] as const;

const chars: CmpChar[] = CHARACTERS.map((c) => {
  // Kit vigente: el último ajuste, sin el desbloqueo SP ni estados especiales (igual que «Cómo jugarlo»)
  const kit = resolveKit(c, kitVersions(c).filter((v) => v !== 'sp' && v !== 'altered').at(-1)!);
  return {
    id: c.id, name: c.name, ep: c.epithet, el: c.element, img: c.icon ?? thumb(c.art, 320), href: localePath(lang, `/characters/${c.id}`),
    rarity: c.rarity, elLabel: g(`el.${c.element}` as GameKey),
    role: c.role ? g(`role.${c.role}` as GameKey) : null, focus: c.focus ? g(`focus.${c.focus}` as GameKey) : null,
    av: c.availability ? g(`av.${c.availability}` as GameKey) : null,
    tier: tierOf(c.id, c.element).rank, bf: c.blackFlash, released: date(c.releaseDateJP),
    stats: {
      hp: c.stats.hp, attack: c.stats.attack, jujutsu: c.stats.jujutsu, gauge: c.stats.specialGauge,
      ce: c.stats.ceInitial != null ? g('ch.ce.value', { a: c.stats.ceInitial ?? '—', b: c.stats.ceMax ?? '—' }) : null,
    },
    skills: SLOTS.map(([slot, key]) => ({ label: g(key), name: kit[slot]?.name ?? null, cost: kit[slot]?.cost ?? null, img: kit[slot]?.img ?? null })),
    memories: c.memories.map((m) => ({ name: m.name, img: m.img ? thumb(m.img, 96) : null, href: m.id ? localePath(lang, `/memories/${m.id}`) : null })),
  };
});
---

<BaseLayout lang={lang} title={t('nav.compare')} description={t('nav.compare.desc')}>
  <div class="mx-auto max-w-5xl px-4 pt-12 pb-8 lg:px-6">
    <header class="mb-8">
      <p class="eyebrow flex items-center gap-1.5"><Icon name="grid" size={13} /> {t('nav.database')}</p>
      <h1 class="mt-2 text-4xl font-black text-bone sm:text-5xl">{t('nav.compare')}</h1>
      <p class="mt-3 max-w-2xl text-dust">{t('nav.compare.desc')}.</p>
    </header>
    <Compare client:only="react" chars={chars} labels={labels} locale={LOCALE_META[lang].htmlLang} />
  </div>
</BaseLayout>
