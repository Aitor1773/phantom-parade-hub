---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import CollectionCard from '@/components/tools/CollectionCard';
import { CHARACTERS, thumb } from '@/data/characters';
import { MEMORIES } from '@/data/memories';
import { SITE } from '@/config/site';
import { gameDict, type GameKey } from '@/i18n/game';
import { localePath, staticLocalePaths, useT, type Locale } from '@/i18n/utils';

export const getStaticPaths = staticLocalePaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);
const KEYS = ['cl.chars', 'cl.mems', 'cl.ssr', 'cl.byel', 'cl.empty', 'cl.player', 'cl.missing', 'cl.best', 'tk.download'] as const satisfies readonly GameKey[];
const labels = gameDict(lang, KEYS);
const el = gameDict(lang, ['el.red', 'el.blue', 'el.green', 'el.yellow'] as const);
const chars = CHARACTERS.map((c) => ({ id: c.id, name: c.name, ep: c.epithet ?? null, rarity: c.rarity, el: c.element, img: thumb(c.art, 320) }));
const memories = MEMORIES.map((m) => ({ id: m.id, rarity: m.rarity }));
---

<BaseLayout lang={lang} title={t('nav.collection')} description={t('nav.collection.desc')}>
  <div class="mx-auto max-w-7xl px-4 pt-12 pb-8 lg:px-6">
    <header class="mb-8">
      <p class="eyebrow flex items-center gap-1.5"><Icon name="user" size={13} /> {t('nav.tools')}</p>
      <h1 class="mt-2 text-4xl font-black text-bone sm:text-5xl">{t('nav.collection')}</h1>
      <p class="mt-3 max-w-2xl text-dust">{t('nav.collection.desc')}. <a href={localePath(lang, '/account')} class="text-flame underline underline-offset-2">{t('nav.account')}</a></p>
    </header>
    <CollectionCard client:only="react" chars={chars} memories={memories} labels={labels} accountPath={localePath(lang, '/account')} siteName={SITE.name}
      colors={{ red: el['el.red'], blue: el['el.blue'], green: el['el.green'], yellow: el['el.yellow'] }} />
  </div>
</BaseLayout>
