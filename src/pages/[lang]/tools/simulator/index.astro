---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import GachaSimulator from '@/components/tools/GachaSimulator';
import { GACHA } from '@/data/gacha';
import { GLOBAL_BANNERS, JP_BANNERS } from '@/data/banners';
import { CHARACTERS, srcsetOf, thumb } from '@/data/characters';
import { MEMORIES, illustSrc, illustSrcset } from '@/data/memories';
import type { Rate } from '@/lib/gacha-math';
import { gameDict, type GameKey } from '@/i18n/game';
import { localePath, staticLocalePaths, useT, type Locale } from '@/i18n/utils';

export const getStaticPaths = staticLocalePaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);

const KEYS = [
  'sim.x1', 'sim.x10', 'sim.auto', 'sim.reset', 'sim.last', 'sim.empty', 'sim.disclaimer', 'sim.stats', 'sim.pulls', 'sim.spent',
  'sim.since', 'sim.first', 'sim.points', 'sim.pity.ok', 'sim.got', 'sim.rate', 'sim.tenth', 'sim.char', 'sim.mem',
  'sim.banner', 'sim.standard', 'sim.featured', 'sim.featured.note',
] as const satisfies readonly GameKey[];

// Lo que puede salir, con su imagen (versiones pequeñas: cada carta mide ~120 px)
const ch = (c: (typeof CHARACTERS)[number]) => ({ id: c.id, name: c.name, img: thumb(c.art, 320), srcset: srcsetOf(c.art, 640) });
const STD = (c: (typeof CHARACTERS)[number]) => !c.availability || c.availability === 'standard';
const mem = (m: (typeof MEMORIES)[number]) => ({ id: m.id, name: m.name, img: illustSrc(m, 320), srcset: illustSrcset(m) });
const pools = {
  'SSR-character': CHARACTERS.filter((c) => c.rarity === 'SSR' && STD(c)).map(ch),
  'SR-character': CHARACTERS.filter((c) => c.rarity === 'SR' && STD(c)).map(ch),
  'R-character': CHARACTERS.filter((c) => c.rarity === 'R' && STD(c)).map(ch),
  'SSR-memory': MEMORIES.filter((m) => m.rarity === 'SSR' && m.availability === 'gacha').map(mem),
  'SR-memory': MEMORIES.filter((m) => m.rarity === 'SR' && m.availability === 'gacha').map(mem),
  'R-memory': MEMORIES.filter((m) => m.rarity === 'R' && m.availability === 'gacha').map(mem),
};
// Banners con personajes destacados, abiertos o por venir (Global y JP)
const now = Date.now();
const byId = new Map(CHARACTERS.map((c) => [c.id, c]));
const banners = [...GLOBAL_BANNERS.map((b) => ['global', b] as const), ...JP_BANNERS.map((b) => ['jp', b] as const)]
  .filter(([, b]) => b.kind === 'gacha' && b.characters.length && (!b.end || Date.parse(b.end) > now) && Date.parse(b.start) < now + 60 * 86400e3)
  .map(([server, b]) => ({ id: b.id, name: b.name, server, featured: b.characters.map((id) => byId.get(id)).filter((c) => !!c).filter((c) => c!.rarity === 'SSR').map((c) => ch(c!)) }))
  .filter((b) => b.featured.length);
const labels = gameDict(lang, KEYS);
const gacha = {
  cubesPerPull: GACHA.cubesPerPull,
  cubesPer10: GACHA.cubesPer10,
  pity: GACHA.pity,
  rates: GACHA.rates.map((r) => ({ ...r })) as Rate[],
};
---

<BaseLayout lang={lang} title={t('nav.simulator')} description={t('nav.simulator.desc')}>
  <div class="mx-auto max-w-7xl px-4 pt-12 pb-8 lg:px-6">
    <header class="mb-8">
      <p class="eyebrow flex items-center gap-1.5"><Icon name="sparkles" size={13} /> {t('nav.tools')}</p>
      <h1 class="mt-2 text-4xl font-black text-bone sm:text-5xl">{t('nav.simulator')}</h1>
      <p class="mt-3 max-w-2xl text-dust">{t('nav.simulator.desc')}. <a href={localePath(lang, '/tools/pulls')} class="text-flame underline underline-offset-2">{t('nav.pulls')}</a></p>
    </header>
    <GachaSimulator client:only="react" gacha={gacha} labels={labels} pools={pools} banners={banners} />
  </div>
</BaseLayout>
