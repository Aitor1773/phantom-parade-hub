---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import GachaSimulator from '@/components/tools/GachaSimulator';
import { GACHA } from '@/data/gacha';
import type { Rate } from '@/lib/gacha-math';
import { gameDict, type GameKey } from '@/i18n/game';
import { localePath, staticLocalePaths, useT, type Locale } from '@/i18n/utils';

export const getStaticPaths = staticLocalePaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);

const KEYS = [
  'sim.x1', 'sim.x10', 'sim.auto', 'sim.reset', 'sim.last', 'sim.empty', 'sim.disclaimer', 'sim.stats', 'sim.pulls', 'sim.spent',
  'sim.since', 'sim.first', 'sim.points', 'sim.pity.ok', 'sim.got', 'sim.rate', 'sim.tenth', 'sim.char', 'sim.mem',
] as const satisfies readonly GameKey[];
const labels = gameDict(lang, KEYS);
const gacha = {
  cubesPerPull: GACHA.cubesPerPull,
  cubesPer10: GACHA.cubesPer10,
  pity: GACHA.pity,
  rates: GACHA.rates.map((r) => ({ ...r })) as Rate[],
  sourceLabel: GACHA.source.label,
  sourceUrl: GACHA.source.url,
};
---

<BaseLayout lang={lang} title={t('nav.simulator')} description={t('nav.simulator.desc')}>
  <div class="mx-auto max-w-7xl px-4 pt-12 pb-8 lg:px-6">
    <header class="mb-8">
      <p class="eyebrow flex items-center gap-1.5"><Icon name="sparkles" size={13} /> {t('nav.tools')}</p>
      <h1 class="mt-2 text-4xl font-black text-bone sm:text-5xl">{t('nav.simulator')}</h1>
      <p class="mt-3 max-w-2xl text-dust">{t('nav.simulator.desc')}. <a href={localePath(lang, '/tools/pulls')} class="text-flame underline underline-offset-2">{t('nav.pulls')}</a></p>
    </header>
    <GachaSimulator client:only="react" gacha={gacha} labels={labels} />
  </div>
</BaseLayout>
