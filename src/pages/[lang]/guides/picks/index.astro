---
// Recomendaciones de Game8 (fuente principal; citada en Créditos): reroll, ticket de SSR, ranking de SR,
// mejores de rareza baja y personajes que pasan al gacha permanente (data/normalized/game8/guides.json).
// Los textos se ven en japonés o ya traducidos; los personajes y memorias, siempre.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ElementIcon from '@/components/ElementIcon';
import { CHARACTERS, thumb } from '@/data/characters';
import { getMemory } from '@/data/memories';
import { G8_GUIDES, G8_GUIDES_AT, g8t, memoryIdOfJp, webIdOfJp, type G8GuideEntry } from '@/data/game8';
import { useG, type GameKey } from '@/i18n/game';
import { LOCALE_META, localePath, staticLocalePaths, useT, type Locale } from '@/i18n/utils';

export const getStaticPaths = staticLocalePaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);
const g = useG(lang);
const tr = (s: string | null | undefined) => g8t(s, lang);
const day = (iso: string) => new Intl.DateTimeFormat(LOCALE_META[lang].htmlLang, { dateStyle: 'long', timeZone: 'Asia/Tokyo' }).format(new Date(iso));

const KEYS = ['reroll', 'ticket', 'standard', 'sr', 'lowrarity'] as const;
const RANK_STYLE: Record<string, string> = {
  SSS: 'bg-rarity-ssr text-ash', SS: 'bg-flame text-ash', S: 'bg-ember text-ash', A: 'bg-crimson text-bone', B: 'bg-char text-bone', C: 'bg-cinder text-dust', D: 'bg-coal text-smoke',
};

/** Personaje o memoria de la web a partir del nombre japonés */
function resolve(e: { name: string }) {
  const cid = webIdOfJp(e.name);
  const c = cid ? CHARACTERS.find((x) => x.id === cid) : null;
  if (c) return { href: localePath(lang, `/characters/${c.id}`), name: `${c.epithet ? `${c.epithet} · ` : ''}${c.name}`, img: c.icon ?? (c.art ? thumb(c.art, 320) : null), el: c.element as string | null };
  const mid = memoryIdOfJp(e.name);
  const m = mid ? getMemory(mid) : null;
  if (m) return { href: localePath(lang, `/memories/${m.id}`), name: m.name, img: m.icon ? thumb(m.icon, 96) : null, el: null };
  return { href: null, name: e.name, img: null, el: null };
}
const entryView = (e: G8GuideEntry) => ({
  ...resolve(e),
  rank: e.rank,
  // Las estrellas de prioridad (★★★★☆) se dejan tal cual; el resto, traducido
  points: e.points.map((p) => (/^[★☆]+$/.test(p) ? p : tr(p))).filter((p): p is string => !!p),
  related: (e.related ?? []).map(resolve).filter((r) => r.href),
});

const guides = KEYS.filter((k) => G8_GUIDES[k]).map((k) => {
  const gd = G8_GUIDES[k];
  return {
    key: k,
    sections: gd.sections.map((s) => ({
      title: tr(s.title),
      blocks: s.blocks.map((b) => ({ title: tr(b.title), text: b.text.map(tr).filter((x): x is string => !!x), entries: b.entries.map(entryView).filter((e) => e.href) }))
        .filter((b) => b.entries.length || b.text.length),
    })).filter((s) => s.blocks.length),
    pending: lang !== 'ja' && gd.sections.some((s) => !tr(s.title)),
  };
});
---

<BaseLayout lang={lang} title={t('nav.picks')} description={t('nav.picks.desc')}>
  <div class="mx-auto max-w-6xl px-4 pt-12 pb-16 lg:px-6">
    <header class="mb-6">
      <p class="eyebrow">{t('nav.guides')}</p>
      <h1 class="mt-2 text-4xl font-black text-bone sm:text-5xl">{t('nav.picks')}</h1>
      <p class="mt-3 max-w-2xl text-dust">{t('nav.picks.desc')}</p>
      <p class="mt-1 text-xs text-smoke">{g('tl.updated')}: {day(G8_GUIDES_AT)}</p>
    </header>

    <div role="tablist" class="gp-tabs mb-6 flex gap-1 overflow-x-auto border-b border-line">
      {guides.map(({ key }, i) => (
        <button type="button" role="tab" data-tab={key} aria-selected={i === 0 ? 'true' : 'false'} class="-mb-px shrink-0 border-b-2 border-transparent px-4 py-2.5 text-sm font-semibold whitespace-nowrap text-dust transition hover:text-bone aria-selected:border-ember aria-selected:text-bone">
          {g(`gp.${key}` as GameKey)}
        </button>
      ))}
    </div>

    {guides.map(({ key, sections, pending }, i) => (
      <section class="gp-panel space-y-8" data-panel={key} hidden={i !== 0}>
        {pending && <p class="rounded-lg border border-line bg-cinder/50 px-3 py-2 text-sm text-smoke">{g('g8.pending')}</p>}
        {sections.map((s) => (
          <div>
            {s.title && <h2 class="text-2xl font-bold text-bone">{s.title}</h2>}
            <div class="mt-3 space-y-5">
              {s.blocks.map((b) => (
                <div class="card p-4 sm:p-5">
                  {b.title && <h3 class="font-sans text-base font-bold text-bone">{b.title}</h3>}
                  {b.text.map((p) => <p class="mt-2 text-sm text-dust">{p}</p>)}
                  {b.entries.length > 0 && (b.entries.some((e) => e.points.length) ? (
                    <ul class="mt-3 grid gap-2 md:grid-cols-2">
                      {b.entries.map((e) => (
                        <li class="flex gap-3 rounded-lg border border-line bg-cinder/40 p-2.5">
                          <a href={e.href!} class="relative size-12 shrink-0 overflow-hidden rounded-md bg-coal">
                            {e.img && <img src={e.img} alt="" loading="lazy" class="size-full object-cover object-top" />}
                            {e.el && <span class="absolute right-0.5 bottom-0.5"><ElementIcon el={e.el as 'red'} size={12} /></span>}
                          </a>
                          <div class="min-w-0 text-sm">
                            <p class="flex flex-wrap items-center gap-1.5">
                              {e.rank && <span class:list={['rounded px-1.5 py-0.5 font-display text-[11px] font-black', RANK_STYLE[e.rank] ?? 'bg-cinder text-dust']}>{e.rank}</span>}
                              <a href={e.href!} class="font-semibold text-bone hover:text-flame">{e.name}</a>
                            </p>
                            {e.points.length > 0 && (
                              <ul class="mt-1 space-y-0.5 text-dust">
                                {e.points.map((p) => (/^[★☆]+$/.test(p) ? <li class="text-flame">{p}</li> : /^【.*】/.test(p) ? <li class="text-xs font-semibold text-smoke">{p}</li> : <li>· {p}</li>))}
                              </ul>
                            )}
                            {e.related.length > 0 && (
                              <div class="mt-1.5 flex flex-wrap gap-1">
                                {e.related.map((r) => <a href={r.href!} title={r.name} class="block size-7 overflow-hidden rounded bg-coal">{r.img && <img src={r.img} alt={r.name} loading="lazy" class="size-full object-cover" />}</a>)}
                              </div>
                            )}
                          </div>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <div class="mt-3 space-y-2">
                      {[...new Set(b.entries.map((e) => e.rank))].map((rank) => (
                        <div class="flex items-start gap-2">
                          {rank && <span class:list={['grid w-10 shrink-0 place-items-center self-stretch rounded-md font-display text-sm font-black', RANK_STYLE[rank] ?? 'bg-cinder text-dust']}>{rank}</span>}
                          <ul class="flex min-w-0 flex-1 flex-wrap gap-2">
                            {b.entries.filter((e) => e.rank === rank).map((e) => (
                              <li><a href={e.href!} title={e.name} class="block size-14 overflow-hidden rounded-lg ring-1 ring-line transition hover:ring-ember/60">{e.img && <img src={e.img} alt={e.name} loading="lazy" class="size-full object-cover object-top" />}</a></li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))}
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.gp-tabs [data-tab]');
  tabs.forEach((b) => b.addEventListener('click', () => {
    tabs.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    document.querySelectorAll<HTMLElement>('.gp-panel').forEach((p) => { p.hidden = p.dataset.panel !== b.dataset.tab; });
  }));
</script>
