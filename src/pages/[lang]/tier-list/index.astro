---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { ELEMENT_COLOR, Placeholder } from '@/components/characters/CharacterBrowser';
import { CHARACTERS, getCharacter, thumb } from '@/data/characters';
import { TIER_CHANGELOG, TIER_CRITERIA, TIER_LISTS, TIER_LIST_KEYS, TIER_RANKS, type TierListKey } from '@/data/gacha';
import { useG, type GameKey } from '@/i18n/game';
import tierSources from '../../../../data/normalized/tier-sources.json';
import { LOCALE_META, localePath, staticLocalePaths, useT, type Locale } from '@/i18n/utils';

export const getStaticPaths = staticLocalePaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);
const g = useG(lang);

const ELEMENT_KEYS = ['blue', 'red', 'green', 'yellow'];
const tabLabel = (k: TierListKey) => g((ELEMENT_KEYS.includes(k) ? `el.${k}` : `tl.tab.${k}`) as GameKey);
const ROW_STYLE: Record<string, string> = {
  S: 'from-flame to-ember text-ash',
  A: 'from-ember to-ember-deep text-ash',
  B: 'from-crimson to-blood text-bone',
  C: 'from-char to-cinder text-bone',
  D: 'from-cinder to-coal text-dust',
};
const day = (iso: string) => new Intl.DateTimeFormat(LOCALE_META[lang].htmlLang, { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${iso}T00:00:00Z`));
const byId = new Map(CHARACTERS.map((c) => [c.id, c]));

const lists = TIER_LIST_KEYS.map((key) => {
  const list = TIER_LISTS[key];
  const rows = TIER_RANKS.map((rank) => ({
    rank,
    items: Object.entries(list.entries)
      .filter(([, e]) => e.rank === rank)
      .sort((a, b) => b[1].score - a[1].score)
      .map(([id, e]) => ({ c: byId.get(id)!, e }))
      .filter((x) => x.c),
  }));
  const pending = Object.values(list.entries).filter((e) => !e.manual).length;
  const changes = TIER_CHANGELOG.filter((ch) => ch.list === key).slice(0, 40);
  return { key, list, rows, pending, changes };
});
const ssPct = Math.round(TIER_CRITERIA.thresholds[0][1] * 100);
// Rangos de otras webs para comparar (con permiso): por lista (jjkppdb) o generales (Game8, GameWith)
type Src = { name: string; url: string; lists?: Record<string, Record<string, string>>; overall?: Record<string, string> };
const SOURCES = Object.entries((tierSources as unknown as { sources: Record<string, Src> }).sources).map(([key, s]) => ({
  key, name: s.name, url: s.url,
  rank: (list: string, id: string) => s.lists?.[list]?.[id] ?? s.overall?.[id] ?? null,
  perList: !!s.lists,
}));
const OTHER = [
  { name: 'jjkppdb', url: 'https://www.jjkppdb.com/tierlists' },
  { name: 'Game8', url: 'https://game8.jp/jujutsuphanpara/573071' },
  { name: 'GameWith', url: 'https://gamewith.jp/jujutsuphanpara/425595' },
];
---

<BaseLayout lang={lang} title={g('tl.title')} description={g('tl.intro')}>
  <div class="mx-auto max-w-7xl px-4 pt-12 pb-8 lg:px-6">
    <header class="mb-6">
      <p class="eyebrow">{t('nav.guides')}</p>
      <h1 class="mt-2 text-4xl font-black text-bone sm:text-5xl">{g('tl.title')}</h1>
      <p class="mt-3 max-w-2xl text-dust">{g('tl.intro')}</p>
      <a href="#criteria" class="mt-2 inline-block text-xs text-smoke underline underline-offset-2 hover:text-dust">{g('tl.criteria')}</a>
    </header>

    <!-- Comparar con otras webs -->
    {SOURCES.length > 0 && (
      <div class="tl-cmp mb-4 flex flex-wrap items-center gap-2 text-xs" role="group" aria-label={g('tl.cmp')}>
        <span class="text-smoke">{g('tl.cmp')}:</span>
        <button type="button" data-cmp="" aria-pressed="true" class="rounded-full border border-line px-3 py-1 font-semibold text-dust aria-pressed:border-ember/70 aria-pressed:bg-ember/15 aria-pressed:text-bone">{g('tl.cmp.none')}</button>
        {SOURCES.map((s) => (
          <button type="button" data-cmp={s.key} aria-pressed="false" class="rounded-full border border-line px-3 py-1 font-semibold text-dust aria-pressed:border-ember/70 aria-pressed:bg-ember/15 aria-pressed:text-bone">{s.name}</button>
        ))}
        <span class="tl-cmp-note hidden text-smoke">{g('tl.cmp.hint')}</span>
        {SOURCES.map((s) => <a data-cmp-link={s.key} href={s.url} target="_blank" rel="noopener" class="hidden underline underline-offset-2 text-smoke hover:text-dust">{s.name} ↗</a>)}
      </div>
    )}

    <!-- Pestañas: elementos | funciones -->
    <div role="tablist" class="tl-tabs mb-5 flex gap-1 overflow-x-auto border-b border-line">
      {lists.map(({ key }, i) => (
        <>
          {i === 4 && <span class="mx-1 my-2 w-px shrink-0 bg-line" aria-hidden="true"></span>}
          <button type="button" role="tab" data-tab={key} aria-selected={i === 0 ? 'true' : 'false'}
            class="relative flex shrink-0 items-center gap-1.5 px-4 py-2.5 text-sm font-semibold text-dust transition hover:text-bone aria-selected:text-bone">
            {ELEMENT_KEYS.includes(key) && <span class="size-2.5 rounded-full" style={`background:${ELEMENT_COLOR[key]}`}></span>}
            {tabLabel(key)}
            <span class="tab-line absolute inset-x-2 -bottom-px hidden h-0.5 rounded-full bg-gradient-to-r from-ember to-flame"></span>
          </button>
        </>
      ))}
    </div>

    {lists.map(({ key, list, rows, pending, changes }, i) => (
      <section class="tl-panel" data-panel={key} hidden={i !== 0}>
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2 text-xs">
          <p class="text-smoke">{g('tl.reviewed')}: <span class="font-semibold text-dust">{day(list.reviewed)}</span>
            {pending > 0 && <span class="badge-unverified ml-2">{g('tl.draft', { n: pending })}</span>}
          </p>
          <details class="group relative">
            <summary class="btn-secondary h-8 cursor-pointer list-none px-3 text-xs">
              <Icon name="calendar" size={14} /> {tabLabel(key)} · {g('tl.changelog')}
            </summary>
            <div class="absolute right-0 z-20 mt-2 max-h-80 w-80 overflow-y-auto rounded-xl border border-line-strong bg-coal p-3 shadow-2xl shadow-black/60">
              {changes.length ? (
                <ul class="space-y-1.5">
                  {changes.map((ch) => {
                    const c = getCharacter(ch.id);
                    return (
                      <li class="text-[11px] leading-snug text-dust">
                        <span class="text-smoke">{day(ch.date)}</span> · <span class="text-bone">{c ? `${c.epithet ?? ''} ${c.name}` : ch.id}</span>{' '}
                        {ch.from ? <span>{ch.from} → <b class="text-flame">{ch.to}</b></span> : <span><b class="text-flame">{ch.to}</b> ({g('tl.new')})</span>}
                        <span class="text-smoke"> · {g(ch.by === 'manual' ? 'tl.by.manual' : 'tl.by.draft')}</span>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <p class="text-xs text-smoke">{g('tl.changelog.empty')}</p>
              )}
            </div>
          </details>
        </div>

        <div class="space-y-2">
          {rows.map((row) => (
            <div class="flex overflow-hidden rounded-xl border border-line bg-coal/70">
              <div class:list={['grid w-14 shrink-0 place-items-center bg-gradient-to-b font-display text-2xl font-black sm:w-20 sm:text-3xl', ROW_STYLE[row.rank]]}>{row.rank}</div>
              <ul class="flex min-h-24 flex-1 flex-wrap content-start gap-2 p-2.5">
                {row.items.map(({ c, e }) => (
                  <li style={`--el:${ELEMENT_COLOR[c.element] ?? '#ff5a1f'}`}>
                    <a
                      href={localePath(lang, `/characters/${c.id}`)}
                      class="relative block w-[68px] overflow-hidden rounded-lg border-2 border-line transition hover:-translate-y-0.5 hover:border-[color:var(--el)] sm:w-20"
                      title={`${c.epithet ?? ''} ${c.name}${e.note ? ` · ${e.note}` : ''}`}
                    >
                      <span class="relative block aspect-[3/4] bg-cinder">
                        {c.art ? <img src={thumb(c.art, 320)} alt="" loading="lazy" class="size-full object-cover object-top" /> : <Placeholder name={c.name} />}
                        <span class="absolute inset-0 bg-gradient-to-t from-ash/90 via-transparent to-transparent"></span>
                        <span class="absolute top-1 left-1 size-2 rounded-full ring-1 ring-ash" style="background: var(--el)"></span>
                        {e.manual && <span class="absolute top-0.5 right-1 text-[10px] text-flame" title={g('tl.manual')}>✎</span>}
                        {SOURCES.map((s) => {
                          const r = s.rank(key, c.id);
                          return r ? <span class={`cmp cmp-${s.key} absolute right-1 bottom-4 rounded bg-ash/90 px-1 text-[10px] font-black text-flame ring-1 ring-flame/40`} title={`${s.name}: ${r}`}>{r}</span> : null;
                        })}
                        <span class="absolute inset-x-0 bottom-0 truncate px-1 pb-0.5 text-center text-[9px] font-semibold text-bone sm:text-[10px]">{c.name.split(' ').at(-1)}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}

    <div class="mt-12 grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
      <section id="criteria" class="card min-w-0 scroll-mt-24 p-6">
        <h2 class="text-2xl font-bold text-bone">{g('tl.criteria')}</h2>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-dust marker:text-ember">
          <li>{g('tl.c1')}</li>
          <li>{g('tl.c2', { aoe: TIER_CRITERIA.aoeFactor })}</li>
          <li>{g('tl.c3')}</li>
          <li>{g('tl.c4', { ss: ssPct })}</li>
        </ol>
        <h3 class="mt-6 mb-2 font-sans text-sm font-bold text-bone">{g('tl.weights')}</h3>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[420px] text-left text-xs">
            <thead class="text-smoke">
              <tr><th class="py-1.5 pr-3"></th><th class="px-2">{g('tl.m.dmg')}</th><th class="px-2">{g('tl.m.buff')}</th><th class="px-2">{g('tl.m.debuff')}</th><th class="px-2">{g('tl.m.sustain')}</th></tr>
            </thead>
            <tbody>
              {(['attacker', 'support', 'debuffer', 'sustain'] as const).map((gr) => {
                const w = TIER_CRITERIA.roleWeights[gr];
                return (
                  <tr class="border-t border-line">
                    <td class="py-1.5 pr-3 font-semibold text-bone">{g(`tl.g.${gr}` as GameKey)}</td>
                    {[w.dmg, w.buff, w.debuff, w.sustain].map((v) => <td class="px-2 text-dust tabular-nums">{Math.round(v * 100)}%</td>)}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-[11px] text-smoke">{t('footer.license')}</p>
      </section>

      <aside class="card self-start p-6">
        <h2 class="font-sans text-base font-bold text-bone">{g('tl.compare')}</h2>
        <p class="mt-1 text-xs text-smoke">{g('tl.compare.desc')}</p>
        <ul class="mt-4 space-y-2">
          {OTHER.map((o) => (
            <li>
              <a href={o.url} target="_blank" rel="noopener" class="flex items-center justify-between rounded-lg border border-line bg-cinder/50 px-3 py-2.5 text-sm text-bone transition hover:border-line-strong">
                <span>{o.name} <span class="text-xs text-smoke">· {g('tl.jpnote')}</span></span>
                <Icon name="arrowRight" size={14} class="-rotate-45 text-smoke" />
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .tl-tabs button[aria-selected='true'] .tab-line { display: block; }
  summary::-webkit-details-marker { display: none; }
  .cmp { display: none; }
  /* El selector depende del atributo de <html>: fuera del ámbito del componente */
  :global(html[data-cmp='jjkppdb']) .cmp-jjkppdb, :global(html[data-cmp='game8']) .cmp-game8, :global(html[data-cmp='gamewith']) .cmp-gamewith { display: inline-block; }
</style>

<script>
  // Pestañas enlazables (#blue, #damage…)
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tl-tabs [data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('.tl-panel')];
  const show = (key: string, push = true) => {
    if (!panels.some((p) => p.dataset.panel === key)) return;
    tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === key)));
    panels.forEach((p) => (p.hidden = p.dataset.panel !== key));
    if (push) history.replaceState(null, '', `#${key}`);
  };
  tabs.forEach((b) => b.addEventListener('click', () => show(b.dataset.tab!)));
  show(location.hash.slice(1), false);
  window.addEventListener('hashchange', () => show(location.hash.slice(1), false));

  // Comparar con otras webs: muestra su rango sobre cada personaje
  const cmpBtns = [...document.querySelectorAll<HTMLButtonElement>('.tl-cmp [data-cmp]')];
  cmpBtns.forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.cmp ?? '';
    document.documentElement.dataset.cmp = k;
    cmpBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelector('.tl-cmp-note')?.classList.toggle('hidden', !k);
    document.querySelectorAll<HTMLElement>('[data-cmp-link]').forEach((a) => a.classList.toggle('hidden', a.dataset.cmpLink !== k));
  }));
</script>
