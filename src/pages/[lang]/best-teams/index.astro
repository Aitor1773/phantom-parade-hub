---
// Mejores equipos por color y estilo (técnica / físico / híbrido), de la hoja de la comunidad
// (npm run data:best-teams, a diario). Fuente citada en Créditos.
import BaseLayout from '@/layouts/BaseLayout.astro';
import ElementIcon from '@/components/ElementIcon';
import Icon from '@/components/Icon.astro';
import { ELEMENT_COLOR } from '@/components/characters/CharacterBrowser';
import data from '../../../../data/normalized/best-teams.json';
import { getCharacter, srcsetOf, thumb } from '@/data/characters';
import { useG, type GameKey } from '@/i18n/game';
import { LOCALE_META, localePath, staticLocalePaths, useT, type Locale } from '@/i18n/utils';

export const getStaticPaths = staticLocalePaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);
const g = useG(lang);
const es = lang === 'es';
type Team = { color: string; style: string; slots: { role: string; id: string | null }[]; subs: { role: string; ids: { id: string }[] }[] };
const teams = data.teams as Team[];

const TXT = {
  intro: { es: 'El mejor equipo de un solo color para cada estilo de daño: técnica (ritual), físico e híbrido. Debajo de cada uno, los sustitutos de cada puesto por si te falta alguien. Se actualiza a diario con la hoja de equipos de la comunidad.', en: 'The best single-color team for each damage style: Jujutsu, Taijutsu and hybrid. Below each, substitutes for every slot in case you are missing someone. Updated daily from the community team sheet.' },
  subs: { es: 'Sustitutos', en: 'Substitutes' },
  bench: { es: 'Banquillo', en: 'Bench' },
  unknown: { es: 'Por identificar', en: 'To be identified' },
  updated: { es: 'Actualizado', en: 'Updated' },
  builder: { es: 'Monta tu versión en el creador de equipos', en: 'Build your own version in the team builder' },
};
const tx = (k: keyof typeof TXT) => (es ? TXT[k].es : TXT[k].en);
const STYLE: Record<string, { es: string; en: string }> = {
  jujutsu: { es: 'Técnica (ritual)', en: 'Jujutsu' }, taijutsu: { es: 'Físico', en: 'Taijutsu' }, hybrid: { es: 'Híbrido', en: 'Hybrid' },
};
// Roles de la hoja (en español) → texto legible en cada idioma
const ROLE_EN: [RegExp, string][] = [
  [/AUMENTO DE DAÑO/g, 'Damage up'], [/AUMENTO DAÑO/g, 'damage up'], [/SUB DPS/g, 'Sub DPS'], [/DEBUFFER/g, 'Debuffer'], [/BUFFER/g, 'Buffer'],
  [/BANQUILLO/g, 'Bench'], [/UTILIDAD/g, 'Utility'], [/RITUAL/g, 'Jujutsu'], [/F[ÍI]SICO/g, 'Taijutsu'], [/H[ÍI]BRIDO/g, 'Hybrid'], [/STATS/g, 'stats'],
];
const role = (r: string) => {
  const clean = r.replace(/\s*\/\s*/g, ' / ').replace(/\s+/g, ' ').trim();
  if (es) return clean.charAt(0) + clean.slice(1).toLowerCase().replace(/dps/g, 'DPS');
  return ROLE_EN.reduce((s, [re, to]) => s.replace(re, to), clean);
};
const COLORS = ['blue', 'red', 'green', 'yellow'] as const;
const updated = new Intl.DateTimeFormat(LOCALE_META[lang].htmlLang, { dateStyle: 'long' }).format(new Date(data.fetchedAt));
---

<BaseLayout lang={lang} title={t('nav.bestteams')} description={tx('intro')}>
  <div class="mx-auto max-w-7xl px-4 pt-12 pb-8 lg:px-6">
    <header class="mb-6">
      <p class="eyebrow flex items-center gap-1.5"><Icon name="trophy" size={13} /> {t('nav.guides')}</p>
      <h1 class="mt-2 text-4xl font-black text-bone sm:text-5xl">{t('nav.bestteams')}</h1>
      <p class="mt-3 max-w-3xl text-dust">{tx('intro')}</p>
      <p class="mt-2 text-xs text-smoke">{tx('updated')}: {updated} · <a href={localePath(lang, '/team-builder')} class="text-flame underline underline-offset-2">{tx('builder')}</a></p>
    </header>

    <div class="color-tabs mb-8 inline-flex flex-wrap gap-1 rounded-xl border border-line bg-coal p-1" role="tablist">
      {COLORS.map((c, i) => (
        <button type="button" role="tab" data-color={c} aria-selected={i === 0 ? 'true' : 'false'} class="flex items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-bold transition">
          <ElementIcon el={c} size={18} />{g(`el.${c}` as GameKey)}
        </button>
      ))}
    </div>

    {COLORS.map((c, i) => (
      <section data-color-view={c} hidden={i !== 0} class="grid gap-6 xl:grid-cols-3">
        {teams.filter((tm) => tm.color === c).map((tm) => (
          <article class="card p-4" style={`border-color:${ELEMENT_COLOR[c]}55`}>
            <h2 class="flex items-center gap-2 font-sans text-lg font-bold text-bone">
              <ElementIcon el={c} size={24} />
              {g(`el.${c}` as GameKey)} · {es ? STYLE[tm.style].es : STYLE[tm.style].en}
            </h2>
            <ol class="mt-3 grid grid-cols-5 gap-1.5">
              {tm.slots.map((s, k) => {
                const ch = s.id ? getCharacter(s.id) : null;
                return (
                  <li class:list={['min-w-0', k === 4 && 'opacity-80']}>
                    {ch ? (
                      <a href={localePath(lang, `/characters/${ch.id}`)} class="block overflow-hidden rounded-lg border-2 bg-cinder" style={`border-color:${ELEMENT_COLOR[ch.element]}99`} title={`${ch.name}${ch.epithet ? ` · ${ch.epithet}` : ''}`}>
                        {ch.art && <img src={thumb(ch.art, 320)} srcset={srcsetOf(ch.art, 640)} sizes="90px" alt={ch.name} loading="lazy" class="aspect-square w-full object-cover object-top" />}
                      </a>
                    ) : (
                      <span class="grid aspect-square place-items-center rounded-lg border-2 border-dashed border-line bg-cinder text-center text-[9px] text-smoke">{tx('unknown')}</span>
                    )}
                    <span class="mt-1 block truncate text-[11px] font-semibold text-bone">{ch?.name ?? '—'}</span>
                    <span class="block text-[9px] leading-tight text-smoke uppercase">{k === 4 ? tx('bench') : role(s.role)}</span>
                  </li>
                );
              })}
            </ol>
            {tm.subs.some((s) => s.ids.length) && (
              <div class="mt-4 border-t border-line pt-3">
                <p class="mb-2 text-xs font-bold text-bone">{tx('subs')}</p>
                <ul class="space-y-1.5">
                  {tm.subs.filter((s) => s.ids.length).map((s) => (
                    <li class="flex items-center gap-2">
                      <span class="w-24 shrink-0 text-[10px] leading-tight text-smoke uppercase">{role(s.role)}</span>
                      <span class="flex flex-wrap gap-1">
                        {s.ids.map(({ id }) => {
                          const ch = getCharacter(id);
                          return ch && (
                            <a href={localePath(lang, `/characters/${ch.id}`)} title={`${ch.name}${ch.epithet ? ` · ${ch.epithet}` : ''}`} class="block size-9 overflow-hidden rounded-md border bg-cinder" style={`border-color:${ELEMENT_COLOR[ch.element]}88`}>
                              {ch.art && <img src={thumb(ch.art, 320)} alt={ch.name} loading="lazy" class="size-full object-cover object-top" />}
                            </a>
                          );
                        })}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .color-tabs button[aria-selected='true'] { background: var(--color-cinder); color: var(--color-bone); }
  .color-tabs button[aria-selected='false'] { color: var(--color-dust); }
</style>

<script>
  // Pestañas por color (recuerda la última elegida)
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.color-tabs [data-color]')];
  const show = (c: string) => {
    tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.color === c)));
    document.querySelectorAll<HTMLElement>('[data-color-view]').forEach((s) => (s.hidden = s.dataset.colorView !== c));
    try { localStorage.setItem('pp-bestteams-color', c); } catch { /* sin almacenamiento */ }
  };
  tabs.forEach((b) => b.addEventListener('click', () => show(b.dataset.color!)));
  try { const saved = localStorage.getItem('pp-bestteams-color'); if (saved && tabs.some((b) => b.dataset.color === saved)) show(saved); } catch { /* sin almacenamiento */ }
</script>
