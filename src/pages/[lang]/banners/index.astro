---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import BannerCard from '@/components/banners/BannerCard.astro';
import { GLOBAL_BANNERS, GLOBAL_LAG, JP_BANNERS, JP_TIMELINE_META, type Banner } from '@/data/banners';
import { useG } from '@/i18n/game';
import { LOCALE_META, staticLocalePaths, useT, type Locale } from '@/i18n/utils';

export const getStaticPaths = staticLocalePaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);
const g = useG(lang);

// Reparto en la compilación; el script del cliente actualiza estados y cuentas atrás
const NOW = Date.now();
const NO_END_GRACE = 14 * 864e5; // entradas sin fecha de fin (p. ej. actualizaciones): "activas" 14 días
const split = (list: Banner[]) => {
  const now: Banner[] = [], upcoming: Banner[] = [], past: Banner[] = [];
  for (const b of list) {
    const s = +new Date(b.start), e = b.permanent ? Infinity : b.end ? +new Date(b.end) : s + NO_END_GRACE;
    (s > NOW ? upcoming : e > NOW ? now : past).push(b);
  }
  upcoming.reverse(); // el más cercano primero
  return { now, upcoming, past };
};
const gl = split(GLOBAL_BANNERS);
const jp = split(JP_BANNERS);

// Historial JP agrupado por mes
const monthFmt = new Intl.DateTimeFormat(LOCALE_META[lang].htmlLang, { month: 'long', year: 'numeric', timeZone: 'Asia/Tokyo' });
const jpMonths = Object.entries(
  jp.past.reduce<Record<string, Banner[]>>((acc, b) => ((acc[b.start.slice(0, 7)] ??= []).push(b), acc), {}),
);
const updated = new Intl.DateTimeFormat(LOCALE_META[lang].htmlLang, { dateStyle: 'long' }).format(new Date(JP_TIMELINE_META.updated));
---

<BaseLayout lang={lang} title={g('bn.title')} description={t('nav.banners.desc')}>
  <div class="mx-auto max-w-7xl px-4 pt-12 pb-8 lg:px-6">
    <header class="mb-8">
      <p class="eyebrow">{t('nav.banners')}</p>
      <h1 class="mt-2 text-4xl font-black text-bone sm:text-5xl">{g('bn.title')}</h1>
      <p class="mt-3 max-w-xl text-dust">{t('nav.banners.desc')}</p>
    </header>

    <!-- Pestañas de servidor: usan el mismo selector que la barra superior -->
    <div class="server-tabs mb-8 inline-flex gap-1 rounded-xl border border-line bg-coal p-1" role="radiogroup" aria-label={t('nav.server')}>
      <button type="button" role="radio" data-server="global" class="rounded-lg px-4 py-2 text-sm font-bold tracking-wide transition">GLOBAL</button>
      <button type="button" role="radio" data-server="jp" class="rounded-lg px-4 py-2 text-sm font-bold tracking-wide transition">JP</button>
    </div>

    <!-- ── Global ── -->
    <section data-server-view="global">
      <p class="mb-8 flex max-w-2xl items-start gap-2 rounded-lg border border-line bg-coal/70 px-3 py-2 text-xs text-smoke">
        <Icon name="check" size={14} class="mt-0.5 shrink-0 text-ember" />
        {g('bn.globalnote')}
      </p>

      <h2 class="mb-4 text-2xl font-bold text-bone">{g('bn.now')}</h2>
      {gl.now.length ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{gl.now.map((b) => <BannerCard banner={b} lang={lang} />)}</div>
      ) : (
        <div class="card flex items-start gap-3 p-5 text-sm text-dust">
          <Icon name="calendar" size={20} class="mt-0.5 shrink-0 text-flame" />
          <p>
            {g('bn.globalempty')}{' '}
            <a href="https://x.com/JJKPP_GL" target="_blank" rel="noopener" class="text-ember underline underline-offset-2">x.com/JJKPP_GL</a>
          </p>
        </div>
      )}

      {gl.upcoming.length > 0 && (
        <>
          <h2 class="mt-12 mb-4 text-2xl font-bold text-bone">{g('bn.upcoming')}</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{gl.upcoming.map((b) => <BannerCard banner={b} lang={lang} />)}</div>
        </>
      )}

      <h2 class="mt-12 mb-4 text-2xl font-bold text-bone">{g('bn.past')}</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{gl.past.map((b) => <BannerCard banner={b} lang={lang} />)}</div>
    </section>

    <!-- ── JP ── -->
    <section data-server-view="jp">
      <p class="mb-8 flex max-w-2xl items-start gap-2 rounded-lg border border-line bg-coal/70 px-3 py-2 text-xs text-smoke">
        <Icon name="globe" size={14} class="mt-0.5 shrink-0 text-flame" />
        <span>
          {g('bn.jpnote')}{' '}
          <a href={JP_TIMELINE_META.url} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-dust">{g('bn.jpsource')}</a> · {updated}
          {GLOBAL_LAG && <span class="mt-1 block text-dust">{g('bn.lag', { min: GLOBAL_LAG.min, max: GLOBAL_LAG.max, n: GLOBAL_LAG.samples })}</span>}
        </span>
      </p>

      <h2 class="mb-4 text-2xl font-bold text-bone">{g('bn.now')}</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{jp.now.map((b) => <BannerCard banner={b} lang={lang} />)}</div>

      {jp.upcoming.length > 0 && (
        <>
          <h2 class="mt-12 mb-4 text-2xl font-bold text-bone">{g('bn.upcoming')}</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{jp.upcoming.map((b) => <BannerCard banner={b} lang={lang} />)}</div>
        </>
      )}

      <div class="mt-12 mb-4 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-2xl font-bold text-bone">{g('bn.past')}</h2>
        <div class="kind-filter inline-flex gap-1 rounded-lg border border-line bg-coal p-1 text-xs font-semibold" role="radiogroup">
          <button type="button" data-kind-filter="all" aria-pressed="true" class="rounded-md px-3 py-1.5">{g('bn.all')}</button>
          <button type="button" data-kind-filter="gacha" aria-pressed="false" class="rounded-md px-3 py-1.5">{g('bn.gacha')}</button>
          <button type="button" data-kind-filter="event" aria-pressed="false" class="rounded-md px-3 py-1.5">{g('bn.event')}</button>
        </div>
      </div>
      <div class="space-y-3">
        {jpMonths.map(([month, list], i) => (
          <details class="card group px-4" open={i < 2}>
            <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 font-semibold text-bone capitalize">
              {monthFmt.format(new Date(`${month}-15T00:00:00+09:00`))}
              <span class="flex items-center gap-2 text-xs font-normal text-smoke">
                {list.length}
                <Icon name="chevronDown" size={16} class="transition-transform group-open:rotate-180" />
              </span>
            </summary>
            <ul class="border-t border-line pb-2">{list.map((b) => <BannerCard banner={b} lang={lang} compact />)}</ul>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(html:not([data-server='jp'])) [data-server-view='jp'],
  :global(html[data-server='jp']) [data-server-view='global'] {
    display: none;
  }
  .server-tabs button[aria-checked='true'] {
    background: linear-gradient(135deg, var(--color-ember), var(--color-ember-deep));
    color: var(--color-ash);
  }
  .server-tabs button[aria-checked='false'] { color: var(--color-dust); }
  .kind-filter button[aria-pressed='true'] { background: var(--color-cinder); color: var(--color-bone); }
  .kind-filter button[aria-pressed='false'] { color: var(--color-dust); }
  summary::-webkit-details-marker { display: none; }
</style>

<script>
  // Fechas en la zona horaria del usuario
  const lang = document.documentElement.lang;
  document.querySelectorAll<HTMLTimeElement>('time.local-date').forEach((el) => {
    const d = new Date(el.dateTime);
    el.textContent = new Intl.DateTimeFormat(lang, el.dataset.approx ? { dateStyle: 'medium' } : { dateStyle: 'medium', timeStyle: 'short' }).format(d);
  });

  // Cuentas atrás y estado de cada tarjeta
  const cards = [...document.querySelectorAll<HTMLElement>('article[data-banner]')];
  const span = (ms: number, tpl: string) => {
    const h = Math.floor(ms / 36e5), m = Math.floor((ms % 36e5) / 6e4), s = Math.floor((ms % 6e4) / 1000);
    if (h >= 48) return tpl.replace('{d}', String(Math.floor(h / 24))).replace('{h}', String(h % 24));
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  };
  const tick = () => {
    const now = Date.now();
    for (const card of cards) {
      const start = +new Date(card.dataset.start!), end = card.dataset.end ? +new Date(card.dataset.end) : null;
      const cd = card.querySelector<HTMLElement>('.countdown')!;
      const badge = card.querySelector<HTMLElement>('.status-badge')!;
      if (card.dataset.permanent) {
        badge.textContent = '● ' + cd.dataset.lNow;
      } else if (now < start && !card.dataset.startUnknown) {
        cd.textContent = `${cd.dataset.lStarts} ${span(start - now, cd.dataset.lDays!)}`;
        badge.textContent = cd.dataset.lStarts!;
      } else if (end && now < end) {
        cd.textContent = `${cd.dataset.lEnds} ${span(end - now, cd.dataset.lDays!)}`;
        badge.textContent = '● ' + cd.dataset.lNow;
      } else {
        cd.textContent = end ? cd.dataset.lEnded! : '';
        badge.textContent = '';
        card.classList.add('opacity-60');
      }
    }
  };
  tick();
  setInterval(tick, 1000);

  // Filtro por tipo en el historial
  const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-kind-filter]')];
  filterBtns.forEach((btn) =>
    btn.addEventListener('click', () => {
      const k = btn.dataset.kindFilter!;
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      document.querySelectorAll<HTMLElement>('[data-server-view="jp"] li[data-banner]').forEach((li) => {
        li.hidden = k !== 'all' && (k === 'gacha' ? li.dataset.kind !== 'gacha' : li.dataset.kind === 'gacha');
      });
    }),
  );
</script>
