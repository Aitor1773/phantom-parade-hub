---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import ContentTeams from '@/components/teams/ContentTeams';
import CommunityThread from '@/components/teams/CommunityThread.astro';
import { TEAM_KEYS } from '@/components/teams/keys';
import { ELEMENT_COLOR } from '@/components/characters/CharacterBrowser';
import { CHARACTERS, srcsetOf, thumb } from '@/data/characters';
import { MEMORIES } from '@/data/memories';
import { CONTENT, affinityEntries, communityThread, stagesOf, type Content } from '@/data/content';
import { gameDict, useG, type GameKey } from '@/i18n/game';
import { LOCALES, LOCALE_META, localePath, type Locale } from '@/i18n/utils';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => CONTENT.map((c) => ({ params: { lang, id: c.id }, props: { content: c } })));
}

const lang = Astro.params.lang as Locale;
const { content: c } = Astro.props as { content: Content };
const g = useG(lang);
const labels = gameDict(lang, TEAM_KEYS);
const L = gameDict(lang, ['ct.back', 'ct.floors', 'ct.permanent', 'ct.title', 'cm.title', 'cm.desc', 'cm.pending', 'cm.how', 'cm.teams', 'cm.teams.none', 'cm.votes', 'cm.by', 'tm.floor'] as const);
const title = c.kind === 'mode' ? g(`ct.m.${c.id}` as GameKey) : c.name;
const desc = c.kind === 'mode' ? g(`ct.m.${c.id}.d` as GameKey) : g(`ct.cat.${c.category}` as GameKey);
const day = (iso: string) => new Intl.DateTimeFormat(LOCALE_META[lang].htmlLang, { dateStyle: 'long', timeZone: 'Asia/Tokyo' }).format(new Date(iso));

// Equipos de la comunidad (los más votados en el foro)
const charById = new Map(CHARACTERS.map((x) => [x.id, x]));
const memById = new Map(MEMORIES.map((m) => [m.id, m]));
const thread = communityThread(c.id);
const commTeams = (thread?.teams ?? []).slice(0, 6).map((tm) => ({
  ...tm,
  slots: [...tm.main, tm.sub, tm.helper].map((id, i) => ({ c: id ? charById.get(id) : undefined, mem: tm.mems[i] ? memById.get(tm.mems[i]!) : undefined })),
}));
---

<BaseLayout lang={lang} title={`${title} · ${L['ct.title']}`} description={desc}>
  <div class="mx-auto max-w-7xl px-4 pt-10 pb-8 lg:px-6">
    <a href={localePath(lang, '/teams')} class="mb-4 inline-flex items-center gap-1 text-xs text-smoke hover:text-dust"><Icon name="arrowRight" size={12} class="rotate-180" /> {L['ct.back']}</a>
    <header class="mb-6">
      <p class="eyebrow">{c.kind === 'mode' ? L['ct.permanent'] : g(`ct.cat.${c.category}` as GameKey)}</p>
      <h1 class="mt-2 text-3xl font-black text-bone sm:text-4xl">{title}</h1>
      <p class="mt-2 max-w-2xl text-sm text-dust">{c.kind === 'mode' ? desc : ''}</p>
      <p class="mt-2 flex flex-wrap items-center gap-2 text-xs text-smoke">
        {c.server && <span class={c.server === 'jp' ? 'badge-jp' : 'badge-global'}>{c.server === 'jp' ? 'JP' : 'Global'}</span>}
        {c.start && <span>{day(c.start)}{c.end ? ` – ${day(c.end)}` : ''}</span>}
        {c.floors && <span>{L['ct.floors'].replace('{n}', String(c.floors))}</span>}
        <a href="#community" class="ml-auto text-flame underline underline-offset-2">{L['cm.title']}{thread ? ` (${thread.comments})` : ''}</a>
      </p>
    </header>

    <ContentTeams client:only="react" labels={labels} contentName={title} basePath={localePath(lang)} accountPath={localePath(lang, '/account')}
      data={affinityEntries(c.id)} stages={stagesOf(c.id)} contentId={c.id} floors={c.floors} locale={LOCALE_META[lang].htmlLang} />

    <section class="card mt-8 p-5 sm:p-6">
      <h2 class="text-2xl font-bold text-bone">{L['cm.teams']}</h2>
      {commTeams.length ? (
        <ul class="mt-4 space-y-4">
          {commTeams.map((tm) => (
            <li class="rounded-xl border border-line bg-ash/40 p-3">
              <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-smoke">
                <span class="font-bold text-flame">👍 {tm.votes} {L['cm.votes']}</span>
                {tm.floor && <span>{L['tm.floor']} {tm.floor}</span>}
                <span>{L['cm.by']} {tm.author} · {tm.date}</span>
              </div>
              <ul class="grid grid-cols-3 gap-2 sm:grid-cols-6">
                {tm.slots.map((s, i) => (
                  <li class="min-w-0">
                    {s.c ? (
                      <a href={localePath(lang, `/characters/${s.c.id}`)} class="block">
                        <span class="block aspect-square overflow-hidden rounded-lg border-2 bg-cinder" style={`border-color:${ELEMENT_COLOR[s.c.element]}80`}>
                          {thumb(s.c.art, 320) && <img src={thumb(s.c.art, 320)!} srcset={srcsetOf(s.c.art, 640)} sizes="(min-width: 640px) 120px, 30vw" alt="" loading="lazy" decoding="async" class="size-full object-cover object-top" />}
                        </span>
                        <span class="mt-1 block truncate text-[11px] font-semibold text-bone">{s.c.name}</span>
                        <span class="block truncate text-[10px] text-smoke">{labels[i < 4 ? 'tm.main' : i === 4 ? 'tm.sub' : 'tm.helper']}</span>
                      </a>
                    ) : <span class="block aspect-square rounded-lg border border-dashed border-line"></span>}
                    {s.mem && (
                      <span class="mt-1 flex items-center gap-1 rounded-md border border-line bg-ash/50 p-0.5 pr-1">
                        {s.mem.icon ? <img src={s.mem.icon} alt="" loading="lazy" class="size-6 shrink-0 rounded object-cover" /> : <span class="size-6 shrink-0 rounded bg-cinder"></span>}
                        <span class="min-w-0 truncate text-[9px] text-dust">{s.mem.name}</span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      ) : <p class="mt-2 text-sm text-dust">{L['cm.teams.none']}</p>}
    </section>

    <CommunityThread term={c.id} lang={lang} labels={{ title: L['cm.title'], desc: L['cm.desc'], pending: L['cm.pending'], how: L['cm.how'] }} />
  </div>
</BaseLayout>
