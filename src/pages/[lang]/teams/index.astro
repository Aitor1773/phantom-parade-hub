---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { EVENTS, EVENT_CATEGORIES, MODES, affinityEntries } from '@/data/content';
import { gameDict, useG, type GameKey } from '@/i18n/game';
import { LOCALE_META, localePath, staticLocalePaths, useT, type Locale } from '@/i18n/utils';

export const getStaticPaths = staticLocalePaths;

const lang = Astro.params.lang as Locale;
const t = useT(lang);
const g = useG(lang);
const L = gameDict(lang, ['ct.title', 'ct.intro', 'ct.modes', 'ct.events', 'ct.active', 'ct.all', 'ct.search', 'ct.count', 'ct.floors', 'ct.data', 'ct.permanent'] as const);
const day = (iso: string) => new Intl.DateTimeFormat(LOCALE_META[lang].htmlLang, { dateStyle: 'medium', timeZone: 'Asia/Tokyo' }).format(new Date(iso));
const now = Date.now();
const usedCats = EVENT_CATEGORIES.filter((c) => EVENTS.some((e) => e.category === c));
const MODE_ICON: Record<string, string> = {
  'illusory-tower': 'layers', 'domain-investigation': 'target', 'formidable-foes': 'swords',
  'main-quest': 'book', 'cursed-object-collection': 'gift', 'strengthening-quest': 'sparkles',
};
---

<BaseLayout lang={lang} title={L['ct.title']} description={L['ct.intro']}>
  <div class="mx-auto max-w-7xl px-4 pt-12 pb-8 lg:px-6">
    <header class="mb-8">
      <p class="eyebrow flex items-center gap-1.5"><Icon name="swords" size={13} /> {t('nav.guides')}</p>
      <h1 class="mt-2 text-4xl font-black text-bone sm:text-5xl">{L['ct.title']}</h1>
      <p class="mt-3 max-w-2xl text-dust">{L['ct.intro']} <a href={localePath(lang, '/team-builder')} class="text-flame underline underline-offset-2">{t('nav.teambuilder')}</a></p>
    </header>

    <h2 class="mb-4 text-2xl font-bold text-bone">{L['ct.modes']}</h2>
    <ul class="mb-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {MODES.map((m) => {
        const hasData = Object.keys(affinityEntries(m.id)).length > 0;
        return (
          <li>
            <a href={localePath(lang, `/teams/${m.id}`)} class="card card-hover flex h-full gap-3 p-4">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-ember/10 text-ember"><Icon name={(MODE_ICON[m.id] ?? 'swords') as any} size={20} /></span>
              <span class="min-w-0">
                <span class="block font-bold text-bone">{g(`ct.m.${m.id}` as GameKey)}</span>
                <span class="mt-0.5 block text-xs leading-snug text-dust">{g(`ct.m.${m.id}.d` as GameKey)}</span>
                <span class="mt-2 flex flex-wrap gap-1.5 text-[11px]">
                  <span class="badge">{L['ct.permanent']}</span>
                  {m.floors && <span class="badge">{L['ct.floors'].replace('{n}', String(m.floors))}</span>}
                  {hasData && <span class="badge-verified">{L['ct.data']}</span>}
                </span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
      <h2 class="text-2xl font-bold text-bone">{L['ct.events']} <span class="text-sm font-normal text-smoke">· {L['ct.count'].replace('{n}', String(EVENTS.length))}</span></h2>
      <input type="search" class="ev-search h-9 w-full rounded-lg border border-line bg-coal px-3 text-sm text-bone placeholder:text-smoke focus:border-ember/60 focus:outline-none sm:w-72" placeholder={L['ct.search']} aria-label={L['ct.search']} />
    </div>
    <div class="ev-cats mb-4 flex gap-1.5 overflow-x-auto pb-1" role="group">
      <button type="button" data-cat="" aria-pressed="true" class="shrink-0 rounded-full border border-line px-3 py-1 text-xs font-semibold text-dust aria-pressed:border-ember/70 aria-pressed:bg-ember/15 aria-pressed:text-bone">{L['ct.all']}</button>
      {usedCats.map((c) => (
        <button type="button" data-cat={c} aria-pressed="false" class="shrink-0 rounded-full border border-line px-3 py-1 text-xs font-semibold text-dust aria-pressed:border-ember/70 aria-pressed:bg-ember/15 aria-pressed:text-bone">{g(`ct.cat.${c}` as GameKey)}</button>
      ))}
    </div>
    <ul class="ev-list divide-y divide-line overflow-hidden rounded-xl border border-line bg-coal/60">
      {EVENTS.map((e) => {
        const active = e.start && +new Date(e.start) <= now && (!e.end || +new Date(e.end) >= now);
        const hasData = Object.keys(affinityEntries(e.id)).length > 0;
        return (
          <li data-cat={e.category} data-q={e.name.toLowerCase()}>
            <a href={localePath(lang, `/teams/${e.id}`)} class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3 transition hover:bg-cinder/60">
              <span class="min-w-0 flex-1 basis-60">
                <span class="block truncate text-sm font-semibold text-bone">{e.name}</span>
                <span class="block text-xs text-smoke">{g(`ct.cat.${e.category}` as GameKey)} · {e.start && day(e.start)}{e.end ? ` – ${day(e.end)}` : ''}</span>
              </span>
              <span class="flex gap-1.5 text-[11px]">
                {active && <span class="badge-limited">{L['ct.active']}</span>}
                {hasData && <span class="badge-verified">{L['ct.data']}</span>}
                <span class={e.server === 'jp' ? 'badge-jp' : 'badge-global'}>{e.server === 'jp' ? 'JP' : 'Global'}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>

<script>
  const list = document.querySelectorAll<HTMLLIElement>('.ev-list > li');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.ev-cats [data-cat]')];
  const search = document.querySelector<HTMLInputElement>('.ev-search')!;
  let cat = '';
  const apply = () => {
    const q = search.value.trim().toLowerCase();
    list.forEach((li) => { li.hidden = (!!cat && li.dataset.cat !== cat) || (!!q && !li.dataset.q!.includes(q)); });
  };
  chips.forEach((b) => b.addEventListener('click', () => {
    cat = b.dataset.cat ?? '';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
    apply();
  }));
  search.addEventListener('input', apply);
</script>
