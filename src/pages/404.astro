---
// Página 404. Sin ella, Cloudflare Pages responde a cualquier archivo que falte con la portada
// (código 200) y el navegador la guardaba una semana en lugar de la imagen.
import { LOCALES, DEFAULT_LOCALE } from '@/i18n/utils';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 · Phantom Parade Hub</title>
  </head>
  <body style="background:#0b0605;color:#f5e9e0;font-family:system-ui;display:grid;place-items:center;min-height:100vh;margin:0;text-align:center">
    <main>
      <p style="font-size:3rem;font-weight:900;margin:0;color:#ff5a1f">404</p>
      <p>Page not found · Página no encontrada</p>
      <a id="home" href={`/${DEFAULT_LOCALE}/`} style="color:#ff5a1f">Phantom Parade Hub</a>
    </main>
    <script is:inline define:vars={{ LOCALES, DEFAULT_LOCALE }}>
      const first = location.pathname.split('/')[1];
      document.getElementById('home').href = '/' + (LOCALES.includes(first) ? first : DEFAULT_LOCALE) + '/';
    </script>
  </body>
</html>
