---
// Partículas de brasa que suben. Ligero (canvas 2D), pausado fuera de
// pantalla y desactivado con prefers-reduced-motion.
interface Props {
  class?: string;
  density?: number;
}
const { class: className, density = 60 } = Astro.props;
---

<canvas class:list={['embers pointer-events-none absolute inset-0 h-full w-full', className]} data-density={density} aria-hidden="true"></canvas>

<script>
  const COLORS = ['255,226,122', '255,182,39', '255,90,31', '200,16,46'];

  document.querySelectorAll<HTMLCanvasElement>('canvas.embers').forEach((canvas) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const ctx = canvas.getContext('2d')!;
    const density = Number(canvas.dataset.density) || 60;
    let w = 0, h = 0, raf = 0, running = false;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    type P = { x: number; y: number; r: number; vy: number; vx: number; life: number; max: number; c: string; wob: number };
    let ps: P[] = [];

    const spawn = (initial = false): P => ({
      x: Math.random() * w,
      y: initial ? Math.random() * h : h + 10,
      r: Math.random() * 1.8 + 0.4,
      vy: -(Math.random() * 0.6 + 0.25),
      vx: (Math.random() - 0.5) * 0.25,
      life: 0,
      max: Math.random() * 400 + 250,
      c: COLORS[(Math.random() * COLORS.length) | 0],
      wob: Math.random() * Math.PI * 2,
    });

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round((density * w) / 1280);
      ps = Array.from({ length: n }, () => spawn(true));
    };

    const tick = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.globalCompositeOperation = 'lighter';
      for (let i = 0; i < ps.length; i++) {
        const p = ps[i];
        p.life++;
        p.wob += 0.02;
        p.x += p.vx + Math.sin(p.wob) * 0.2;
        p.y += p.vy;
        const t = p.life / p.max;
        const a = t < 0.15 ? t / 0.15 : 1 - (t - 0.15) / 0.85;
        if (p.life > p.max || p.y < -10) {
          ps[i] = spawn();
          continue;
        }
        const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 4);
        g.addColorStop(0, `rgba(${p.c},${0.9 * a})`);
        g.addColorStop(1, `rgba(${p.c},0)`);
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r * 4, 0, Math.PI * 2);
        ctx.fill();
      }
      raf = requestAnimationFrame(tick);
    };

    const start = () => { if (!running) { running = true; raf = requestAnimationFrame(tick); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    resize();
    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  });
</script>
