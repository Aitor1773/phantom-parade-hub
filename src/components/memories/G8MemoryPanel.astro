---
// Valoración de una memoria según Game8 (fuente principal; citada en Créditos): rangos al máximo y en automático,
// cómo conseguirla, puntos clave de la tier list y personajes recomendados por uso.
// Los textos solo se enseñan en japonés o ya traducidos.
import { CHARACTERS, thumb, type Character } from '@/data/characters';
import type { Memory } from '@/data/memories';
import { g8MemOf, g8t, memTierPoints, webIdOfJp } from '@/data/game8';
import { useG } from '@/i18n/game';
import { localePath, type Locale } from '@/i18n/utils';

interface Props { m: Memory; lang: Locale }
const { m, lang } = Astro.props;
const g = useG(lang);
const d = g8MemOf(m.id);
const tr = (s: string | null | undefined) => g8t(s, lang);

const RANK_STYLE: Record<string, string> = {
  SSS: 'border-rarity-ssr/70 bg-rarity-ssr/15 text-rarity-ssr',
  SS: 'border-rarity-ssr/60 bg-rarity-ssr/10 text-rarity-ssr',
  S: 'border-ember/60 bg-ember/10 text-ember',
  A: 'border-rarity-sr/60 bg-rarity-sr/10 text-rarity-sr',
};
const ratings = d ? ([['overall', 'g8.mem.max'], ['auto', 'g8.auto']] as const).map(([k, label]) => ({ label: g(label), rank: d.ratings[k] })).filter((r) => r.rank) : [];
const points = d ? (memTierPoints(d.name)?.entry.points ?? []).map(tr).filter((p): p is string => !!p) : [];
const byJp = (jp: string) => { const id = webIdOfJp(jp); return id ? CHARACTERS.find((x) => x.id === id) ?? null : null; };
const groups = (d?.groups ?? []).map((gr) => ({ title: gr.title ? tr(gr.title) : null, chars: gr.characters.map((c) => byJp(c.name)).filter((c): c is Character => !!c) })).filter((gr) => gr.chars.length);
const obtain = tr(d?.obtain);
const max = d?.stats.max;
---

{d && (
  <section id="analysis" class="card mb-10 p-5 sm:p-6">
    <h2 class="text-2xl font-bold text-bone">{g('g8.title')}</h2>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      {ratings.map((r) => (
        <span class:list={['flex items-center gap-2 rounded-lg border px-3 py-1.5', RANK_STYLE[r.rank!] ?? 'border-line bg-cinder text-dust']}>
          <span class="text-[11px] font-semibold tracking-wide uppercase opacity-80">{r.label}</span>
          <span class="font-display text-lg font-black">{r.rank}</span>
        </span>
      ))}
      {obtain && <span class="badge border-line-strong bg-cinder text-dust">{g('g8.obtain')}: {obtain}</span>}
    </div>

    {points.length > 0 && (
      <ul class="mt-4 space-y-1.5 text-sm text-dust">{points.map((p) => <li class="flex gap-2"><span class="text-ember">◆</span><span>{p}</span></li>)}</ul>
    )}

    {max && max.hp != null && d.stats.maxLevel && (
      <p class="mt-4 text-xs text-smoke">
        {g('g8.mem.maxstats', { n: d.stats.maxLevel })}: HP {max.hp}% · {g('ch.attack')} {max.taijutsu}% · {g('ch.jujutsu')} {max.jujutsu}%
      </p>
    )}

    {groups.length > 0 && (
      <>
        <h3 class="mt-6 mb-2 font-sans text-sm font-bold text-bone">{g('g8.mem.for')}</h3>
        <div class="space-y-3">
          {groups.map((gr) => (
            <div>
              {gr.title && <p class="mb-1.5 text-xs font-semibold text-flame">{gr.title}</p>}
              <ul class="flex flex-wrap gap-2">
                {gr.chars.map((c) => {
                  const img = c.icon ?? (c.art ? thumb(c.art, 320) : null);
                  const title = `${c.epithet ? `${c.epithet} · ` : ''}${c.name}`;
                  return (
                    <li>
                      <a href={localePath(lang, `/characters/${c.id}`)} title={title} class="block size-12 overflow-hidden rounded-lg ring-1 ring-line transition hover:ring-ember/60">
                        {img ? <img src={img} alt={title} loading="lazy" class="size-full object-cover object-top" /> : null}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </>
    )}
  </section>
)}
